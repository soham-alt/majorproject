<% layout("/layout/boilerplate.ejs") %>

<div class="row mt-4">
    <div class="col-10 offset-1">
        <h3>My bookings</h3>

        <% if(bookings.length === 0){ %>
            <div class="empty-listings">
                <h4>No bookings yet</h4>
                <p>Book a listing to see it here.</p>
            </div>
        <% } %>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(let booking of bookings){ %>
                <% if(booking.listing){ %>
                        <div class="card col listing-card">
                            <a href="/listings/<%= booking.listing._id %>" class="listdiv">
                            <img src="<%= booking.listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                            <div class="card-body">
                                <p class="card-text">
                                    <b><%= booking.listing.title %><br></b>
                                    <%= booking.listing.location %>, <%= booking.listing.country %><br>
                                    Booked on <%= booking.createdAt.toDateString() %>
                                </p>
                            </div>
                            </a>
                            <div class="card-body">
                                <form method="post" action="/bookings/<%= booking._id %>?_method=delete">
                                    <button class="btn btn-sm btn-outline-danger">Cancel booking</button>
                                </form>
                            </div>
                        </div>
                <% } %>
            <% } %>
        </div>
    </div>
</div>
